unit dmCoThread_U;

interface

uses
  System.SysUtils, System.Classes, Data.DB, Data.Win.ADODB;

type
  TdmCoThread = class(TDataModule)
    procedure DataModuleCreate(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
    conDB : TADOConnection;
    tblUsers : TADOTable;
    tblItems : TADOTable;
    tblPurchases : TADOTable;
     tblRatings : TADOTable;
  end;

var
  dmCoThread: TdmCoThread;
  sName,sSurname,sUsername,sPAss1,sRePAss,sEmail  : String;

implementation

{%CLASSGROUP 'Vcl.Controls.TControl'}

{$R *.dfm}

procedure TdmCoThread.DataModuleCreate(Sender: TObject);
begin
// CONSTRUCTOR
conDB := TADOConnection.Create(self);
tblUsers := TADOTable.Create(Self);
 tblItems := TADOTable.Create(Self);


// SET UP PROPERTIES
conDB.ConnectionString := 'Provider=Microsoft.Jet.OLEDB.4.0;Data Source=CoThread.mdb;Persist Security Info=False';
conDB.LoginPrompt := False;
conDB.Connected := True;

tblUsers.Connection := conDB;
tblUsers.TableName := 'Users';
tblUsers.Active := True;

 tblItems.Connection := conDB;
tblItems.TableName := 'Users';
tblItems.Active := True;

 tblPurchases.Connection := conDB;
tblPurchases.TableName := 'Users';
tblPurchases.Active := True;

tblRatings.Connection := conDB;
tblRatings.TableName := 'Users';
tblRatings.Active := True;


end;

end.
