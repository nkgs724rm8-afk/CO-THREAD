unit dmsCoolHub_U;

interface

uses
  System.SysUtils, System.Classes, Data.DB, Data.Win.ADODB;

type
  TdmsCoolHub = class(TDataModule)
    procedure DataModuleCreate(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
    conDB : TADOConnection;
    tblUsers : TADOTable;
    tblTeachers : TADOTable;
    tblStudents : TADOTable;
    tblSchools : TADOTable;
     tblTasks : TADOTable;
      tblEvents : TADOTable;
      tblAnnouncements : TADOTable
  end;

var
  dmsCoolHub: TdmsCoolHub;
  sUser,sNAme,sSurname,sUsername,sPAss1,sPAss2,sEmail,sSchool, sSubject,sClassNo,sPass,sSection,sDOB,sGrade  : String;

implementation

{%CLASSGROUP 'Vcl.Controls.TControl'}

{$R *.dfm}

procedure TdmsCoolHub.DataModuleCreate(Sender: TObject);
begin
// CONSTRUCTOR
conDB := TADOConnection.Create(self);
tblUsers := TADOTable.Create(Self);
tblTeachers := TADOTable.Create(Self);
tblStudents := TADOTable.Create(Self);
tblSchools := TADOTable.Create(Self);
tblTasks := TADOTable.Create(Self);
 tblEvents := TADOTable.Create(Self);
 tblAnnouncements := TADOTable.Create(Self);

// SET UP PROPERTIES
conDB.ConnectionString := 'Provider=Microsoft.Jet.OLEDB.4.0;Data Source=sCoolHub.mdb;Persist Security Info=False';
conDB.LoginPrompt := False;
conDB.Connected := True;

tblUsers.Connection := conDB;
tblUsers.TableName := 'Users';
tblUsers.Active := True;

tblTeachers.Connection := conDB;
tblTeachers.TableName := 'Teachers';
tblTeachers.Active := True;

tblStudents.Connection := conDB;
tblStudents.TableName := 'Students';
tblStudents.Active := True;

tblSchools.Connection := conDB;
tblSchools.TableName := 'Schools';
tblSchools.Active := True;

 tblTasks.Connection := conDB;
tblTasks.TableName := 'Tasks';
tblTasks.Active := True;

 tblEvents.Connection := conDB;
tblEvents.TableName := 'Events';
tblEvents.Active := True;

 tblAnnouncements.Connection := conDB;
tblAnnouncements.TableName := 'Announcements';
tblAnnouncements.Active := True;
end;

end.
