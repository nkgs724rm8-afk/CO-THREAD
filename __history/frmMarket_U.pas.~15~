procedure TfrmMarket.FormClose(Sender: TObject; var Action: TCloseAction);
begin
 Application.Terminate;
end;

procedure TfrmMarket.LoadFeed(DataType: String);
 var
   pnlItem: TPanel;
 imgProduct: TImage;
 lblTitle: TLabel;
 lblPrice: TLabel;
 iOffset: Integer;
 begin
 iOffset := 5;
 With dmCoThread do
 begin
 tblItems.First;
 while not tblItems.Eof do
 begin
      pnlItem := TPanel.Create(sbMarket);

    pnlItem.Parent := sbMarket;

    pnlItem.Left := 5;
    pnlItem.Top := iOffset;

    pnlItem.Width := sbMarket.Width - 25;
    pnlItem.Height := 100;

    pnlItem.BevelOuter := bvRaised;

    pnlItem.Tag := tblItems['ItemID'];

    pnlItem.OnClick := ItemClick;

        imgProduct := TImage.Create(pnlItem);

    imgProduct.Parent := pnlItem;

    imgProduct.Left := 5;
    imgProduct.Top := 5;

    imgProduct.Width := 80;
    imgProduct.Height := 80;

    imgProduct.Stretch := True;

        if FileExists(tblItems['ImagePath']) then
        begin
           imgProduct.Picture.LoadFromFile(tblItems['ImagePath']);
          imgProduct.OnClick := ItemClick;
        end;


           lblTitle := TLabel.Create(pnlItem);

    lblTitle.Parent := pnlItem;

    lblTitle.Caption := tblItems['ItemName'];

    lblTitle.Font.Size := 11;
    lblTitle.Font.Style := [fsBold];

    lblTitle.Left := 100;
    lblTitle.Top := 10;

    lblTitle.OnClick := ItemClick;

        lblPrice := TLabel.Create(pnlItem);

    lblPrice.Parent := pnlItem;

    lblPrice.Caption :=
      'R' + FormatFloat('#,##0.00',
      tblItems['Price']);

    lblPrice.Left := 100;
    lblPrice.Top := 40;

    lblPrice.Font.Color := clGreen;
    lblPrice.Font.Size := 10;

    lblPrice.OnClick := ItemClick;

       iOffset := iOffset + pnlItem.Height + 10;

    tblItems.Next;
  end;

end;

 end;



