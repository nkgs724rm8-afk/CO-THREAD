procedure TfrmProfile.FormShow(Sender: TObject);
var
  dAvgRating: Double;
  i: Integer;
  arrStars: array[1..5] of TImage;
begin
  arrStars[1] := imgStar1;
  arrStars[2] := imgStar2;
  arrStars[3] := imgStar3;
  arrStars[4] := imgStar4;
  arrStars[5] := imgStar5;

  dmCoThread.qrySQL.Close;
  dmCoThread.qrySQL.SQL.Clear;
  dmCoThread.qrySQL.SQL.Add('SELECT AVG(Rating) AS AvgRating FROM Ratings WHERE Seller_ID = ' + IntToStr(dmCoThread.iCurrentUserID));
  dmCoThread.qrySQL.Open;

  if not dmCoThread.qrySQL.FieldByName('AvgRating').IsNull then
    dAvgRating := dmCoThread.qrySQL.FieldByName('AvgRating').AsFloat
  else
    dAvgRating := 0;

  dmCoThread.qrySQL.Close;

  for i := 1 to 5 do
  begin
    if i <= Round(dAvgRating) then
      arrStars[i].Picture.LoadFromFile('Images\star_filled.png')
    else
      arrStars[i].Picture.LoadFromFile('Images\star_empty.png');
  end;


 dmCoThread.qrySQL.Close;
  dmCoThread.qrySQL.SQL.Clear;
  dmCoThread.qrySQL.SQL.Add('SELECT * FROM Users WHERE User_ID = ' + IntToStr(dmCoThread.iCurrentUserID));
  dmCoThread.qrySQL.Open;

  stName.Caption := dmCoThread.qrySQL.FieldByName('FirstName').AsString + ' ' + dmCoThread.qrySQL.FieldByName('Surname').AsString;
  stUsername.Caption := dmCoThread.qrySQL.FieldByName('Username').AsString;
  stEmail.Caption := dmCoThread.qrySQL.FieldByName('Email').AsString;

  dmCoThread.qrySQL.Close;
end;

