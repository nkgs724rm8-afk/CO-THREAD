unit frmRespondOffer_U;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.ExtCtrls, Vcl.StdCtrls, dmCothread_U,
  Vcl.Imaging.pngimage;

type
  TfrmRespondOffer = class(TForm)
    lblItemName: TLabel;
    lblAmount: TLabel;
    lblBuyer: TLabel;
    imgAcceptBtn: TImage;
    imgDeclineBtn: TImage;
    lblOffer: TLabel;
    imgItem: TImage;
    imgBackBtn: TImage;
    procedure FormShow(Sender: TObject);
    procedure imgAcceptbtnClick(Sender: TObject);
    procedure imgDeclinebtnClick(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure imgBackBtnClick(Sender: TObject);

  private
    procedure InsertNotification(iUserID: Integer; sMessage: String;
      iOfferID: Integer; sType: String);
    procedure LoadOfferDetails;
    { Private declarations }
  public
    { Public declarations }
  end;

var
  frmRespondOffer: TfrmRespondOffer;

implementation
uses
frmNotifications_U;

{$R *.dfm}

procedure TfrmRespondOffer.FormClose(Sender: TObject; var Action: TCloseAction);
begin
application.terminate;
end;

procedure TfrmRespondOffer.FormShow(Sender: TObject);
begin
  LoadOfferDetails;
end;


procedure TfrmRespondOffer.LoadOfferDetails;
begin
  dmCoThread.qrySQL.Close;
  dmCoThread.qrySQL.SQL.Clear;
  dmCoThread.qrySQL.SQL.Add(
    'SELECT Offers.*, Items.ItemName, Users.Username FROM (Offers ' +
    'INNER JOIN Items ON Offers.Item_ID = Items.Item_ID) ' +
    'INNER JOIN Users ON Offers.Buyer_ID = Users.User_ID ' +
    'WHERE Offers.Offer_ID = ' + IntToStr(dmCoThread.iSelectedOfferID));
  dmCoThread.qrySQL.Open;

  if not dmCoThread.qrySQL.IsEmpty then
  begin
    lblItemName.Caption := dmCoThread.qrySQL.FieldByName('ItemName').AsString;
    lblBuyer.Caption := dmCoThread.qrySQL.FieldByName('Username').AsString;
    lblAmount.Caption := 'R' + dmCoThread.qrySQL.FieldByName('OfferAmount').AsString;
  end;

  dmCoThread.qrySQL.Close;
end;

procedure TfrmRespondOffer.imgAcceptbtnClick(Sender: TObject);
var
  iItemID, iBuyerID, iSellerID: Integer;
  sAmount: String;
begin
  dmCoThread.qrySQL.Close;
  dmCoThread.qrySQL.SQL.Clear;
  dmCoThread.qrySQL.SQL.Add('SELECT * FROM Offers WHERE Offer_ID = ' + IntToStr(dmCoThread.iSelectedOfferID));
  dmCoThread.qrySQL.Open;
  iItemID := dmCoThread.qrySQL.FieldByName('Item_ID').AsInteger;
  iBuyerID := dmCoThread.qrySQL.FieldByName('Buyer_ID').AsInteger;
  iSellerID := dmCoThread.qrySQL.FieldByName('Seller_ID').AsInteger;
  sAmount := dmCoThread.qrySQL.FieldByName('OfferAmount').AsString;
  dmCoThread.qrySQL.Close;

  // Mark this offer accepted
  dmCoThread.qrySQL.SQL.Clear;
  dmCoThread.qrySQL.SQL.Add('UPDATE Offers SET Status = ''Accepted'' WHERE Offer_ID = ' + IntToStr(dmCoThread.iSelectedOfferID));
  dmCoThread.qrySQL.ExecSQL;

  // Auto-decline any other pending offers on the same item
  dmCoThread.qrySQL.SQL.Clear;
  dmCoThread.qrySQL.SQL.Add('UPDATE Offers SET Status = ''Declined'' WHERE Item_ID = ' + IntToStr(iItemID) +
    ' AND Offer_ID <> ' + IntToStr(dmCoThread.iSelectedOfferID) + ' AND Status = ''Pending''');
  dmCoThread.qrySQL.ExecSQL;

  // Record the purchase
  dmCoThread.qrySQL.SQL.Clear;
  dmCoThread.qrySQL.SQL.Add('INSERT INTO Purchases (Item_ID, Buyer_ID, Seller_ID, PricePaid, PurchaseDate) VALUES (' +
    IntToStr(iItemID) + ', ' + IntToStr(iBuyerID) + ', ' + IntToStr(iSellerID) + ', ' +
    sAmount + ', #' + FormatDateTime('mm/dd/yyyy', Now) + '#)');
  dmCoThread.qrySQL.ExecSQL;

  // Mark item sold
  dmCoThread.qrySQL.SQL.Clear;
  dmCoThread.qrySQL.SQL.Add('UPDATE Items SET Status = ''Sold'' WHERE Item_ID = ' + IntToStr(iItemID));
  dmCoThread.qrySQL.ExecSQL;

  // Notify buyer: accepted
  InsertNotification(iBuyerID, 'Your offer was accepted! You bought the item for R' + sAmount + '.', dmCoThread.iSelectedOfferID, 'Accepted');

  // Notify buyer: prompt to leave a review
  InsertNotification(iBuyerID, 'Please leave a review for the seller.', dmCoThread.iSelectedOfferID, 'ReviewPrompt');

  ShowMessage('Offer accepted.');
  frmNotifications.Show;
  Self.Hide;
end;

procedure TfrmRespondOffer.imgBackBtnClick(Sender: TObject);
begin
frmRespondOffer.hide;
frmNotifications.show;
end;

procedure TfrmRespondOffer.imgDeclinebtnClick(Sender: TObject);
var
  iBuyerID: Integer;
begin
  dmCoThread.qrySQL.Close;
  dmCoThread.qrySQL.SQL.Clear;
  dmCoThread.qrySQL.SQL.Add('SELECT Buyer_ID FROM Offers WHERE Offer_ID = ' + IntToStr(dmCoThread.iSelectedOfferID));
  dmCoThread.qrySQL.Open;
  iBuyerID := dmCoThread.qrySQL.FieldByName('Buyer_ID').AsInteger;
  dmCoThread.qrySQL.Close;

  dmCoThread.qrySQL.SQL.Clear;
  dmCoThread.qrySQL.SQL.Add('UPDATE Offers SET Status = ''Declined'' WHERE Offer_ID = ' + IntToStr(dmCoThread.iSelectedOfferID));
  dmCoThread.qrySQL.ExecSQL;

  InsertNotification(iBuyerID, 'Your offer was declined.', dmCoThread.iSelectedOfferID, 'Declined');

  ShowMessage('Offer declined.');
  frmNotifications.Show;
  Self.Hide;
end;

procedure TfrmRespondOffer.InsertNotification(iUserID: Integer; sMessage: String; iOfferID: Integer; sType: String);
begin
  dmCoThread.qrySQL.SQL.Clear;
  dmCoThread.qrySQL.SQL.Add('INSERT INTO Notifications (User_ID, Message, NotificationDate, IsRead, Offer_ID, NotificationType) VALUES (' +
    IntToStr(iUserID) + ', ''' + StringReplace(sMessage, '''', '''''', [rfReplaceAll]) + ''', #' +
    FormatDateTime('mm/dd/yyyy', Now) + '#, False, ' + IntToStr(iOfferID) + ', ''' + sType + ''')');
  dmCoThread.qrySQL.ExecSQL;
end;


end.
