end;

procedure TfrmSHome.imgLogoutbtnClick(Sender: TObject);
begin
  if MessageDlg('Are you sure you want to log out?', mtConfirmation, [mbYes, mbNo], 0) = mrYes then
   begin
sUsername := '';
frmWelcome.Show;
frmsHome.Hide;
   end;
end;

procedure TfrmSHome.LoadFeed(DataType: String);
var
  sb: TScrollBox;
  p: TPanel;
  lblTitle, lblDate, lblDescription: TLabel;
  yOffset: Integer;
begin
  if DataType = 'Tasks' then sb := sbTasks
  else if DataType = 'Events' then sb := sbEvents
  else if DataType = 'Announcements' then sb := sbAnnouncements
  else Exit;

  sb.DestroyComponents;
  yOffset := 5;

  with dmsCoolHub do
  begin
    if DataType = 'Tasks' then
    begin
      tblTasks.Filtered := False;
      tblTasks.Filter := Format('Class = ''%s'' AND School = ''%s''',
                                [sClass, sSchool]);
      tblTasks.Filtered := True;

      tblTasks.First;
      while not tblTasks.Eof do
      begin
        //Create panel
        p := TPanel.Create(sb);
        p.Parent := sb;
        p.Left := 5;
        p.Top := yOffset;
        p.Width := sb.Width - 20;
        p.BevelOuter := bvRaised;

        //Title
        lblTitle := TLabel.Create(p);
        lblTitle.Parent := p;
        lblTitle.Caption := 'Task: ' + tblTasks['Title'];
        lblTitle.Font.Style := [fsBold];
        lblTitle.Left := 5;
        lblTitle.Top := 5;

        //Due Date
        lblDate := TLabel.Create(p);
        lblDate.Parent := p;
        lblDate.Caption := 'Due: ' + FormatDateTime('dd mmm yyyy', tblTasks['DueDate']);
        lblDate.Font.Size := 8;
        lblDate.Left := 5;
        lblDate.Top := 25;

        //Description
        lblDescription := TLabel.Create(p);
        lblDescription.Parent := p;
        lblDescription.Caption := tblTasks['Description'];
        lblDescription.WordWrap := True;
        lblDescription.AutoSize := True;
        lblDescription.Left := 5;
        lblDescription.Top := 45;
        lblDescription.Width := p.Width - 10;

        //Adjust panel height
        p.Height := lblDescription.Top + lblDescription.Height + 5;

        yOffset := p.Top + p.Height + 5;
        tblTasks.Next;
      end;
      tblTasks.Filtered := False;
    end
    else if DataType = 'Events' then
    begin
      tblEvents.Filtered := False;
      tblEvents.Filter := Format('School = ''%s''', [ sSchool]);
      tblEvents.Filtered := True;

      tblEvents.First;
      while not tblEvents.Eof do
      begin
        p := TPanel.Create(sb);
        p.Parent := sb;
        p.Left := 5;
        p.Top := yOffset;
        p.Width := sb.Width - 20;
        p.BevelOuter := bvRaised;

        lblTitle := TLabel.Create(p);
        lblTitle.Parent := p;
        lblTitle.Caption := 'Event: ' + tblEvents['EventName'];
        lblTitle.Font.Style := [fsBold];
        lblTitle.Left := 5;
        lblTitle.Top := 5;

        lblDate := TLabel.Create(p);
        lblDate.Parent := p;
        lblDate.Caption := 'Date: ' + FormatDateTime('dd mmm yyyy', tblEvents['EventDate']);
        lblDate.Font.Size := 8;
        lblDate.Left := 5;
        lblDate.Top := 25;

        lblDescription := TLabel.Create(p);
        lblDescription.Parent := p;
        lblDescription.Caption := tblEvents['Description'];
        lblDescription.WordWrap := True;
        lblDescription.AutoSize := True;
        lblDescription.Left := 5;
        lblDescription.Top := 45;
        lblDescription.Width := p.Width - 10;

        p.Height := lblDescription.Top + lblDescription.Height + 5;
        yOffset := p.Top + p.Height + 5;

        tblEvents.Next;
      end;
      tblEvents.Filtered := False;
    end
    else if DataType = 'Announcements' then
    begin
        tblAnnouncements.Filtered := False;
      tblAnnouncements.Filter := Format('School = ''%s''', [ sSchool]);
      tblAnnouncements.Filtered := True;

      tblAnnouncements.First;
      while not tblAnnouncements.Eof do
      begin
        p := TPanel.Create(sb);
        p.Parent := sb;
        p.Left := 5;
        p.Top := yOffset;
        p.Width := sb.Width - 20;
        p.BevelOuter := bvRaised;

        lblTitle := TLabel.Create(p);
        lblTitle.Parent := p;
        lblTitle.Caption := tblAnnouncements['Title'];
        lblTitle.Font.Style := [fsBold];
        lblTitle.Left := 5;
        lblTitle.Top := 5;

        lblDate := TLabel.Create(p);
        lblDate.Parent := p;
        lblDate.Caption := 'Posted: ' + FormatDateTime('dd mmm yyyy', tblAnnouncements['PostDate']);
        lblDate.Font.Size := 8;
        lblDate.Left := 5;
        lblDate.Top := 25;

        lblDescription := TLabel.Create(p);
        lblDescription.Parent := p;
        lblDescription.Caption := tblAnnouncements['Description'];
        lblDescription.WordWrap := True;
        lblDescription.AutoSize := True;
        lblDescription.Left := 5;
        lblDescription.Top := 45;
        lblDescription.Width := p.Width - 10;

        p.Height := lblDescription.Top + lblDescription.Height + 5;
        yOffset := p.Top + p.Height + 5;

        tblAnnouncements.Next;
      end;
    end;
  end;
end;

