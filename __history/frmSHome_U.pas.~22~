procedure TfrmSHome.LoadCalendarItems(SelectedDate: TDate);
var
  sDate: string;
begin
   lstCalendarItems.Clear;
  sDate := FormatDateTime('dd/mm/yyyy', SelectedDate);

  with dmsCoolHub do
  begin

    tblTasks.Filtered := False;
    tblTasks.Filter := Format(
      'DueDate = #%s# AND Class = ''%s'' AND School = ''%s''',
      [sDate, sClass, sSchool]);
    tblTasks.Filtered := True;

    tblTasks.First;
    if not tblTasks.Eof then
    begin
      lstCalendarItems.Items.Add('--- Tasks ---');
      while not tblTasks.Eof do
      begin
        lstCalendarItems.Items.Add('• ' + tblTasks['Title']);
        lstCalendarItems.Items.Add('   ' + tblTasks['Description']);
        lstCalendarItems.Items.Add('');
        tblTasks.Next;
      end;
    end;
    tblTasks.Filtered := False;


    tblEvents.Filtered := False;
    tblEvents.Filter := Format(
      'EventDate = #%s# AND School = ''%s''',
      [sDate, sSchool]);
    tblEvents.Filtered := True;

    tblEvents.First;
    if not tblEvents.Eof then
    begin
      lstCalendarItems.Items.Add('--- Events ---');
      while not tblEvents.Eof do
      begin
        lstCalendarItems.Items.Add('• ' + tblEvents['EventName']);
        lstCalendarItems.Items.Add('   ' + tblEvents['Description']);
        lstCalendarItems.Items.Add('');
        tblEvents.Next;
      end;
    end;
    tblEvents.Filtered := False;
  end;

  if lstCalendarItems.Items.Count = 0 then
    lstCalendarItems.Items.Add('No tasks or events for this date.');
end;

 procedure TfrmSHome.CalendarDateChanged(Sender: TObject);
begin
  LoadCalendarItems(Calendar.Date);
end;

end.
