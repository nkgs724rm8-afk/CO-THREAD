frmWelcome_U;

{$R *.dfm}

procedure TfrmSHome.SetupUserInfo;
 var
  i: Integer;
begin
 


    for i := Low(Schools) to High(Schools) do
    if sSchool = Schools[i] then
    begin
       imgSHomeBG.Picture.LoadFromFile(ExtractFilePath(Application.ExeName) + 'Win32\Debug\images\' + SchoolImages[i]);
       imgProfileBG.Picture.LoadFromFile(ExtractFilePath(Application.ExeName) + 'Win32\Debug\images\' + ProfileBG[i]);
       with dmsCoolHub do
       begin
         tblSchools.First;
         while not tblSchools.eof  do
         begin
           if tblSchools['School'] = sSchool then
           begin
             sSchoolName := tblSchools['SchoolName'];
             break;
           end
           else
           begin
             tblSchools.Next;
           end;
         end;
       end;
    end;
    pgcStudents.ActivePage := tsProfile;
  txtSchool.Caption := sSchoolName;
  txtName.Caption := sName + ' ' + sSurname;
  txtGrade.Caption := sGrade;
  txtBirthday.Caption := sDOB;
  txtEmail.Caption := sEmail;
  txtUsername.Caption := sUsername;
  txtSection.Caption := sSection;
end;

procedure TfrmSHome.FormClose(Sender: TObject; var Action: TCloseAction);
begin
 Application.Terminate;
end;

