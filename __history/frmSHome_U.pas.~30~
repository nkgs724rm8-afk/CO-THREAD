 //Extracts Records from tables and displays it in the relevant scrollboxes
procedure TfrmSHome.LoadFeed(DataType: String);
var
  sbox: TScrollBox;
  pnlFeed: TPanel;
  lblTitle, lblDate, lblDescription: TLabel;
  iOffset: Integer;
begin
  if DataType = 'Tasks' then sbox := sbTasks
  else if DataType = 'Events' then sbox := sbEvents
  else if DataType = 'Announcements' then sbox := sbAnnouncements
  else Exit;

  sbox.DestroyComponents;
  iOffset := 5;
  // Tasks
  with dmsCoolHub do
  begin
    if DataType = 'Tasks' then
    begin
      tblTasks.Filtered := False;
      tblTasks.Filter := Format('Class = ''%s'' AND School = ''%s''',
                                [sClass, sSchool]);
      tblTasks.Filtered := True;

      tblTasks.First;
      while not tblTasks.Eof do
      begin
        //Create panel
        pnlFeed := TPanel.Create(sbox);
        pnlFeed.Parent := sbox;
        pnlFeed.Left := 5;
        pnlFeed.Top := iOffset;
        pnlFeed.Width := sbox.Width - 20;
        pnlFeed.BevelOuter := bvRaised;

        //Title
        lblTitle := TLabel.Create(pnlFeed);
        lblTitle.Parent := pnlfeed;
        lblTitle.Caption := 'Task: ' + tblTasks['Title'];
        lblTitle.Font.Style := [fsBold];
        lblTitle.Left := 5;
        lblTitle.Top := 5;

        //Due Date
        lblDate := TLabel.Create(pnlFeed);
        lblDate.Parent := pnlfeed;
        lblDate.Caption := 'Due: ' + FormatDateTime('dd mmm yyyy', tblTasks['DueDate']);
        lblDate.Font.Size := 8;
        lblDate.Left := 5;
        lblDate.Top := 25;

        //Description
        lblDescription := TLabel.Create(pnlfeed);
        lblDescription.Parent := pnlfeed;
        lblDescription.Caption := tblTasks['Description'];
        lblDescription.WordWrap := True;
        lblDescription.AutoSize := True;
        lblDescription.Left := 5;
        lblDescription.Top := 45;
        lblDescription.Width := pnlfeed.Width - 10;

        //Adjust panel height
        pnlfeed.Height := lblDescription.Top + lblDescription.Height + 5;

        iOffset := pnlfeed.Top + pnlfeed.Height + 5;
        tblTasks.Next;
      end;
      tblTasks.Filtered := False;
    end

    //Events
    else if DataType = 'Events' then
    begin
      tblEvents.Filtered := False;
      tblEvents.Filter := Format('School = ''%s''', [ sSchool]);
      tblEvents.Filtered := True;

      tblEvents.First;
      while not tblEvents.Eof do
      begin
      //Create Panel
        pnlfeed := TPanel.Create(sbox);
        pnlfeed.Parent := sbox;
        pnlfeed.Left := 5;
        pnlfeed.Top := iOffset;
        pnlfeed.Width := sbox.Width - 20;
        pnlfeed.BevelOuter := bvRaised;
         //Title
        lblTitle := TLabel.Create(pnlfeed);
        lblTitle.Parent := pnlfeed;
        lblTitle.Caption := 'Event: ' + tblEvents['EventName'];
        lblTitle.Font.Style := [fsBold];
        lblTitle.Left := 5;
        lblTitle.Top := 5;
        //Event Date
        lblDate := TLabel.Create(pnlfeed);
        lblDate.Parent := pnlfeed;
        lblDate.Caption := 'Date: ' + FormatDateTime('dd mmm yyyy', tblEvents['EventDate']);
        lblDate.Font.Size := 8;
        lblDate.Left := 5;
        lblDate.Top := 25;
         //Description
        lblDescription := TLabel.Create(pnlfeed);
        lblDescription.Parent := pnlfeed;
        lblDescription.Caption := tblEvents['Description'];
        lblDescription.WordWrap := True;
        lblDescription.AutoSize := True;
        lblDescription.Left := 5;
        lblDescription.Top := 45;
        lblDescription.Width := pnlfeed.Width - 10;

        pnlfeed.Height := lblDescription.Top + lblDescription.Height + 5;
        iOffset := pnlfeed.Top + pnlfeed.Height + 5;

        tblEvents.Next;
      end;
      tblEvents.Filtered := False;
    end

    //Announcements
    else if DataType = 'Announcements' then
    begin
        tblAnnouncements.Filtered := False;
      tblAnnouncements.Filter := Format('School = ''%s''', [ sSchool]);
      tblAnnouncements.Filtered := True;

      tblAnnouncements.First;
      while not tblAnnouncements.Eof do
      begin
      //Create Panel
        pnlfeed := TPanel.Create(sbox);
        pnlfeed.Parent := sbox;
        pnlfeed.Left := 5;
        pnlfeed.Top := iOffset;
        pnlfeed.Width := sbox.Width - 20;
        pnlfeed.BevelOuter := bvRaised;
         // Title
        lblTitle := TLabel.Create(pnlfeed);
        lblTitle.Parent := pnlfeed;
        lblTitle.Caption := tblAnnouncements['Title'];
        lblTitle.Font.Style := [fsBold];
        lblTitle.Left := 5;
        lblTitle.Top := 5;
        //Date
        lblDate := TLabel.Create(pnlfeed);
        lblDate.Parent := pnlfeed;
        lblDate.Caption := 'Posted: ' + FormatDateTime('dd mmm yyyy', tblAnnouncements['PostDate']);
        lblDate.Font.Size := 8;
        lblDate.Left := 5;
        lblDate.Top := 25;
         //Description
        lblDescription := TLabel.Create(pnlfeed);
        lblDescription.Parent := pnlfeed;
        lblDescription.Caption := tblAnnouncements['Description'];
        lblDescription.WordWrap := True;
        lblDescription.AutoSize := True;
        lblDescription.Left := 5;
        lblDescription.Top := 45;
        lblDescription.Width := pnlfeed.Width - 10;

        pnlfeed.Height := lblDescription.Top + lblDescription.Height + 5;
        iOffset := pnlfeed.Top + pnlfeed.Height + 5;

        tblAnnouncements.Next;
      end;
    end;
  end;
end;

