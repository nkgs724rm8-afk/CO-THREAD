procedure TfrmSHome.LoadCalendarItems(SelectedDate: TDate);
var
  sDate: string;
begin
   lstSCalendarItems.Clear;
  sDate := FormatDateTime('dd/mm/yyyy', SelectedDate);

  with dmsCoolHub do
  begin

    tblTasks.Filtered := False;
    tblTasks.Filter := '';
    tblTasks.Filter := Format(
      'DueDate = #%s# AND Class = ''%s'' AND School = ''%s''',
      [sDate, sClass, sSchool]);
    tblTasks.Filtered := True;

    tblTasks.First;
    if not tblTasks.Eof then
    begin
      lstSCalendarItems.Items.Add('--- Tasks ---');
      while not tblTasks.Eof do
      begin
        lstSCalendarItems.Items.Add('• ' + tblTasks['Title']);
        lstSCalendarItems.Items.Add('   ' + tblTasks['Description']);
        lstSCalendarItems.Items.Add('');
        tblTasks.Next;
      end;
    end;
    tblTasks.Filtered := False;


    tblEvents.Filtered := False;
    tblEvents.Filter := '';
    tblEvents.Filter := Format(
      'EventDate = #%s# AND School = ''%s''',
      [sDate, sSchool]);
    tblEvents.Filtered := True;

    tblEvents.First;
    if not tblEvents.Eof then
    begin
      lstSCalendarItems.Items.Add('--- Events ---');
      while not tblEvents.Eof do
      begin
        lstSCalendarItems.Items.Add('• ' + tblEvents['EventName']);
        lstSCalendarItems.Items.Add('   ' + tblEvents['Description']);
        lstSCalendarItems.Items.Add('');
        tblEvents.Next;
      end;
    end;
    tblEvents.Filtered := False;
  end;

  if lstSCalendarItems.Items.Count = 0 then
    lstSCalendarItems.Items.Add('No tasks or events for this date.');
end;

 procedure TfrmSHome.CalendarDateChanged(Sender: TObject);
