procedure TfrmSHome.SetupUserInfo;
 var
  i: Integer;
begin
 
  // Loads program background and determines school name
  // Sets up user's info for their profile
    for i := Low(arrSchools) to High(arrSchools) do
    if sSchool = arrSchools[i] then
    begin
       imgSHomeBG.Picture.LoadFromFile(ExtractFilePath(Application.ExeName) + 'Win32\Debug\images\' + arrSchoolImages[i]);
       imgProfileBG.Picture.LoadFromFile(ExtractFilePath(Application.ExeName) + 'Win32\Debug\images\' + arrProfileBG[i]);
       with dmsCoolHub do
       begin
         tblSchools.First;
         while not tblSchools.eof  do
         begin
           if tblSchools['School'] = sSchool then
           begin
             sSchoolName := tblSchools['SchoolName'];
             break;
           end
           else
           begin
             tblSchools.Next;
           end;
         end;
       end;
    end;
    pgcStudents.ActivePage := tsProfile;
  txtSchool.Caption := sSchoolName;
  txtName.Caption := sName + ' ' + sSurname;
  txtGrade.Caption := sGrade;
  txtBirthday.Caption := sDOB;
  txtEmail.Caption := sEmail;
  txtUsername.Caption := sUsername;
  txtSection.Caption := sSection;
end;

