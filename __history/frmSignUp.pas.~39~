procedure TfrmSign.imgCreatebtnClick(Sender: TObject);
begin

  sName := Trim(edtFirstName.Text);
  sSurname := Trim(edtSurname.Text);
  sUsername := Trim(edtUsername.Text);
  sPass1 := Trim(edtPass.Text);
  sRePass := Trim(edtRePass.Text);
  sEmail := Trim(edtEmail.Text);


  if cmbSchool.ItemIndex = -1 then
  begin
    ShowMessage('Please select a school.');
    Exit;
  end
  else
  begin
   sSchoolName := cmbSchool.Items[cmbSchool.ItemIndex];
  end;

   with dmsCoolHub do
  begin
  tblSchools.First;
    while not tblSchools.eof do
    begin
      if tblSchools['SchoolName'] = sSchoolName then
      begin
        sSchool := tblSchools['School'];
        break;
      end
      else
      begin
        tblSchools.Next;
      end;
    end;
  end;
  // Name validation
  if (sName = '') or not (sName[1] in ['A'..'Z']) then
  begin
    ShowMessage('Please enter a valid first name starting with a capital letter.');
    Exit;
  end;

  if (sSurname = '') or not (sSurname[1] in ['A'..'Z']) then
  begin
    ShowMessage('Please enter a valid surname starting with a capital letter.');
    Exit;
  end;

  // Username validation
  if (sUsername = '') or not (sUsername[1] in ['A'..'Z', '0'..'9','a'..'z']) then
  begin
    ShowMessage('Please enter valid username.');
    Exit;
  end;
  with dmsCoolhub do
  begin
  tblUsers.First;
  while not tblUsers.eof do
  begin
    if tblUSers['Username'] = sUsername then
    begin
     ShowMessage('Username already exists.');
     exit;
    end;
    tblusers.Next;
  end;
  end;


  // Password validation
  if (sPass1 = '') or (sRePass = '') then
  begin
    ShowMessage('Please enter and confirm your password.');
    Exit;
  end;

  if sPass1 <> sRePass then
  begin
    ShowMessage('Passwords do not match.');
    Exit;
  end;

  if Length(sPass1) < 6 then
  begin
    ShowMessage('Password must be at least 6 characters long.');
    Exit;
  end;

  sPass := sPass1;
  // Email validation (basic)
  if (sEmail = '') or (Pos('@', sEmail) = 0) or (Pos('.', sEmail) = 0) then
  begin
    ShowMessage('Please enter a valid email address.');
    Exit;
  end;

   if Pos(' ', edtEmail.Text) > 0 then
begin
  ShowMessage('Email cannot contain spaces.');
  edtEmail.SetFocus;
  Exit;
end;

    with dmsCoolhub do
  begin
  tblUsers.First;
  while not tblUsers.eof do
  begin
    if tblUSers['Email'] = sEmail then
    begin
     ShowMessage('Email is already in use.');
     exit;
    end;
    tblusers.Next;
  end;
  end;



 if cbxTeacher.Checked then
 begin
 pnlTeacher.Visible := True;
 pnlTeacher.Enabled := true;
 imgBackbtn.Enabled := false;
 end
 else
 begin
   pnlStudents.visible := true;
   pnlStudents.Enabled := true;
   imgBackbtn.Enabled := false;
 end;

end;


