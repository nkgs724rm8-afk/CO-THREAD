procedure TfrmSign.imgPnlSEnterbtnClick(Sender: TObject);
begin
 sDob := DateToStr(dtpDOB.date);
 sSection := cmbSection.Items[cmbSection.ItemIndex];
 sGrade := cmbGrade.Items[cmbGrade.ItemIndex];

  if cmbGrade.ItemIndex = -1 then
  begin
    ShowMessage('Please select a grade.');
    Exit;
  end
  else
  begin
   sGrade := cmbGrade.Items[cmbGrade.ItemIndex];
  end;

   if (sSection = '') or not (sSection[1] in ['A'..'Z', '1'..'9', 'a'..'z']) then
  begin
    ShowMessage('Please enter a valid class section.');
    Exit;
  end;

  if StrToDate(sDOB) > Date then
  begin
    ShowMessage('Date of birth cannot be in the future.');
    exit;
  end;


  if StrToDate(sDOB) < EncodeDate(YearOf(Date) - 120, 1, 1) then
  begin
    ShowMessage('Please enter a realistic date of birth.');
    exit;
  end;


  if StrToDate(sDOB) > EncodeDate(YearOf(Date) - 13, 1, 1) then
  begin
   ShowMessage('You must be at least 13 years old.');
   exit;
  end;


 with dmsCoolHub do
 begin
  tblUsers.Insert;
   tblUsers['Username'] := sUSername;
   tblUsers['Password'] := sPass;
   tblUsers['Email'] := semail;
   tblUSers['UserType'] := 'Student';
   tblUsers.Post;
   tblStudents.Insert;
   tblStudents['DateOfBirth'] := sDOB;
   tblStudents['Grade'] := sGrade;
   tblStudents['Section'] := sSection;
   tblStudents['Username'] := sUsername;
   tblStudents['FirstName'] := sname;
   tblStudents['Surname'] := sSurname;
   tblStudents['School'] := sSchool;
   tblStudents.Post;
   
  end;
  frmSHome.SetupUserInfo;
  edtEmail.Clear;
  edtFirstName.Clear;
  edtPass.Clear;
  edtRePAss.Clear;
  edtUsername.Clear;
  edtSurname.Clear;
  cmbSchool.ItemIndex := -1;
  cmbGrade.ItemIndex := -1;
  cmbSection.itemindex := -1;
  dtpDob.Date := Date;
  cbxTeacher.Checked := false;
  pnlStudents.Visible := false;
  pnlStudents.Enabled := false;
  frmSign.Hide;
  frmsHome.Show
end;

