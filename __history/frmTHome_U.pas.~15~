 procedure TfrmTHome.LoadCalendarItems(SelectedDate: TDate);
 var
  sDate: string;
begin
  redCalendar.Clear;
  sDate := FormatDateTime('dd/mm/yyyy', SelectedDate);

  with dmsCoolHub do
  begin
    // Load Tasks
    tblTasks.Filtered := False;
    tblTasks.Filter := Format('DueDate = #%s# AND Username = ''%s''', [sDate, sUsername]);
    tblTasks.Filtered := True;

    tblTasks.First;
      redCalendar.Lines.Add('Tasks: ');
      redCalendar.Lines.Add('');
    while not tblTasks.Eof do
    begin
      redCalendar.Lines.Add(tblTasks['Title']);
      redCalendar.Lines.Add(tblTasks['Description']);
      redCalendar.Lines.Add('');
      tblTasks.Next;
    end;
    tblTasks.Filtered := False;

    // Load Events
    tblEvents.Filtered := False;
    tblEvents.Filter := Format('EventDate = #%s#', [sDate]);
    tblEvents.Filtered := True;

    tblEvents.First;
     redCalendar.Lines.Add('Events: ');
     redCalendar.Lines.Add('');
    while not tblEvents.Eof do
    begin
      redCalendar.Lines.Add( tblEvents['EventName']);
      redCalendar.Lines.Add( tblEvents['Description']);
      redCalendar.Lines.Add('');
      tblEvents.Next;
    end;
    tblEvents.Filtered := False;
  end;

  if redCalendar.Lines.Count = 0 then
    redCalendar.Lines.Add('No tasks or events for this date.');
end;
procedure TfrmTHome.CalendarDateChanged(Sender: TObject);
