unit frmTHome_U;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.Imaging.pngimage, Vcl.ExtCtrls, dmsCoolHub_U,
  Vcl.WinXCalendars, Vcl.ComCtrls, Vcl.StdCtrls, Data.DB, Vcl.Grids, Vcl.DBGrids;

type
  TfrmTHome = class(TForm)
    imgTHomeBG: TImage;
    pgcTeachers: TPageControl;
    tsdbManager: TTabSheet;
    tsTasks: TTabSheet;
    tsAnnouncements: TTabSheet;
    tsEvents: TTabSheet;
    imgEventBG: TImage;
    imgProfilebtn: TImage;
    imgdbManagerbtn: TImage;
    imgTasksbtn: TImage;
    imgEventsbtn: TImage;
    imgAnnouncementsbtn: TImage;
    imgTasksBG: TImage;
    imgAnnouncementsBG: TImage;
    edtEventName: TEdit;
    memEventDescription: TMemo;
    dtpDate: TDateTimePicker;
    imgAddeventbtn: TImage;
    edtTaskName: TEdit;
    memTaskDescription: TMemo;
    dtpTaskDate: TDateTimePicker;
    cmbGrade: TComboBox;
    imgLoadTAskbtn: TImage;
    imgMakeAnnouncementbtn: TImage;
    edtAnnouncementTitle: TEdit;
    memAnnouncementDescription: TMemo;
    tsProfile: TTabSheet;
    imgProfileBG: TImage;
    txtClass: TStaticText;
    txtEmail: TStaticText;
    txtName: TStaticText;
    txtSchool: TStaticText;
    txtSubject: TStaticText;
    txtUsername: TStaticText;
    imgLogoutbtn: TImage;
    cmbSection: TComboBox;
    dbgTasks: TDBGrid;
    dsTasks: TDataSource;
    procedure imgProfilebtnClick(Sender: TObject);
    procedure SetupUserInfo;
    procedure imgTasksbtnClick(Sender: TObject);
    procedure imgEventsbtnClick(Sender: TObject);
    procedure imgAnnouncementsbtnClick(Sender: TObject);
    procedure imgMakeAnnouncementbtnClick(Sender: TObject);
    procedure imgLoadTAskbtnClick(Sender: TObject);
    procedure FormCreate(Sender: TObject);
    procedure imgAddeventbtnClick(Sender: TObject);
    procedure imgLogoutbtnClick(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure imgdbManagerbtnClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  frmTHome: TfrmTHome;

implementation
uses
frmWelcome_U;

{$R *.dfm}

procedure TfrmTHome.FormClose(Sender: TObject; var Action: TCloseAction);
begin
 Application.Terminate;
end;

procedure TfrmTHome.FormCreate(Sender: TObject);
begin

memTaskDescription.Clear;
memEventDescription.Clear;
memAnnouncementDescription.Clear;

 dsTasks.DataSet := dmsCoolHub.tblTasks;

dbgTasks.DataSource := dsTasks;
end;

procedure TfrmTHome.imgLogoutbtnClick(Sender: TObject);
begin
 if MessageDlg('Are you sure you want to log out?', mtConfirmation, [mbYes, mbNo], 0) = mrYes then
   begin
    sUsername := '';
    frmWelcome.Show;
    frmTHome.Hide;
   end;
 
end;

procedure TfrmTHome.imgAddeventbtnClick(Sender: TObject);
begin
if Trim(edtEventName.Text) = '' then
  begin
    ShowMessage('Please enter an event title.');
    edtEventName.SetFocus;
    Exit;
  end;

  if Trim(memEventDescription.Text) = '' then
  begin
    ShowMessage('Please enter an event description.');
    memeventDescription.SetFocus;
    Exit;
  end;

  // Insert event into tblEvents
  with dmsCoolHub do
  begin
    tblEvents.Insert;
    tblEvents['Title'] := edtEventName.Text;
    tblEvents['Description'] := memEventDescription.Text;
    tblEvents['EventDate'] := dtpDate.Date;
    tblevents['School'] := sSchool;
    tblEvents.Post;
  end;

  ShowMessage('Event saved successfully!');


  edtEventname.Clear;
  memEventDescription.Clear;
  dtpDate.Date := Date;
end;

procedure TfrmTHome.imgAnnouncementsbtnClick(Sender: TObject);
begin
pgcTeachers.ActivePage := tsAnnouncements;
end;

procedure TfrmTHome.imgdbManagerbtnClick(Sender: TObject);
begin
 pgcTeachers.ActivePage := tsdbManager;

  with dmsCoolHub.tblTasks do
begin
  Filtered := False; // reset any previous filters
  Filter := Format('School = ''%s''', [sSchool]); // filter for current teacher's school
  Filtered := True;  // apply the filter
end;

 with dmsCoolHub.tblEvents do
begin
  Filtered := False;
  Filter := Format('School = ''%s''', [sSchool]);
  Filtered := True;
end;

with dmsCoolHub.tblAnnouncements do
begin
  Filtered := False;
  Filter := Format('School = ''%s''', [sSchool]);
  Filtered := True;
end;
end;

procedure TfrmTHome.SetupUserInfo;
begin
     with dmsCoolHub do
       begin
         tblSchools.First;
         while not tblSchools.eof  do
         begin
           if tblSchools['School'] = sSchool then
           begin
             sSchoolName := tblSchools['SchoolName'];
             break;
           end
           else
           begin
             tblSchools.Next;
           end;
         end;
       end;
    pgcTeachers.ActivePage := tsProfile;
  txtClass.Caption := sClassNo;
   txtSubject.Caption := sSubject ;
   txtUSername.Caption := sUsername ;
  txtname.Caption :=  sname + ' ' + sSurname ;
  txtEmail.Caption := sEmail ;
   txtSchool.Caption := sSchoolName ;
end;


procedure TfrmTHome.imgEventsbtnClick(Sender: TObject);
begin
 pgcTeachers.ActivePage := tsEvents;
end;

procedure TfrmTHome.imgLoadTAskbtnClick(Sender: TObject);
begin
// Input validation
  if Trim(edtTaskName.Text) = '' then
  begin
    ShowMessage('Please enter a task title.');
    edtTaskName.SetFocus;
    Exit;
  end;

  if Trim(memTaskDescription.Text) = '' then
  begin
    ShowMessage('Please enter a task description.');
    memTaskDescription.SetFocus;
    Exit;
  end;

  if cmbGrade.ItemIndex = -1 then
  begin
    ShowMessage('Please select a grade.');
    cmbGrade.SetFocus;
    Exit;
  end;
  if cmbSection.ItemIndex = -1 then
  begin
    ShowMessage('Please select a section.');
    cmbSection.SetFocus;
    Exit;
  end;

  //Insert task into tblTasks
  with dmsCoolHub do
  begin
    tblTasks.Insert;
    tblTasks['Title'] := edtTaskName.Text;
    tblTasks['Description'] := memTaskDescription.Text;
    tblTasks['DueDate'] := dtpTaskDate.Date;
    tblTasks['Class'] := cmbGrade.items[cmbGrade.ItemIndex] + cmbSection.items[cmbSection.ItemIndex];
      tblTasks['School'] := sSchool;
    tblTasks.Post;
  end;

  ShowMessage('Task saved successfully!');

  //Clear form for next entry
  edtTaskname.Clear;
  memTaskDescription.Clear;
  dtpTaskDate.Date := Date;
  cmbGrade.ItemIndex := -1;
  cmbSection.ItemIndex := -1;
end;


procedure TfrmTHome.imgMakeAnnouncementbtnClick(Sender: TObject);
begin
  if Trim(edtAnnouncementTitle.Text) = '' then
  begin
    ShowMessage('Please enter an announcement title.');
    edtannouncementtitle.SetFocus;
    Exit;
  end;

  if Trim(memAnnouncementDescription.Text) = '' then
  begin
    ShowMessage('Please enter an Announcement description.');
    memAnnouncementDescription.SetFocus;
    Exit;
  end;
  with dmsCoolHub do
  begin
  tblAnnouncements.Insert;
    tblAnnouncements['Title'] := edtAnnouncementTitle.Text;
tblAnnouncements['Description'] := memAnnouncementDescription.Text;
tblAnnouncements['PostDate'] := Date;
tblAnnouncements.Post;
  end;

   edtAnnouncementTitle.Clear;
  memAnnouncementDescription.Clear;
end;

procedure TfrmTHome.imgProfilebtnClick(Sender: TObject);
begin
 pgcTeachers.ActivePage := tsProfile;
end;

procedure TfrmTHome.imgTasksbtnClick(Sender: TObject);
begin
 pgcTeachers.ActivePage := tsTasks;
end;

end.
