procedure TfrmTHome.LoadCalendarItems(SelectedDate: TDate);
 var
  sDate: string;
begin
   lstTCalendarItems.Clear;
  sDate := FormatDateTime('dd/mm/yyyy', SelectedDate);

  with dmsCoolHub do
  begin

    tblTasks.Filtered := False;
    tblTasks.Filter := '';
    tblTasks.Filter := Format(
      'DueDate = #%s# AND Class = ''%s'' AND School = ''%s''',
      [sDate, sClass, sSchool]);
    tblTasks.Filtered := True;

    tblTasks.First;
    if not tblTasks.Eof then
    begin
      lstTCalendarItems.Items.Add('--- Tasks ---');
      while not tblTasks.Eof do
      begin
        lstTCalendarItems.Items.Add('• ' + tblTasks['Title']);
        lstTCalendarItems.Items.Add('   ' + tblTasks['Description']);
        lstTCalendarItems.Items.Add('');
        tblTasks.Next;
      end;
    end;
    tblTasks.Filtered := False;


    tblEvents.Filtered := False;
    tblEvents.Filter := '';
    tblEvents.Filter := Format(
      'EventDate = #%s# AND School = ''%s''',
      [sDate, sSchool]);
    tblEvents.Filtered := True;

    tblEvents.First;
    if not tblEvents.Eof then
    begin
      lstTCalendarItems.Items.Add('--- Events ---');
      while not tblEvents.Eof do
      begin
        lstTCalendarItems.Items.Add('• ' + tblEvents['EventName']);
        lstTCalendarItems.Items.Add('   ' + tblEvents['Description']);
        lstTCalendarItems.Items.Add('');
        tblEvents.Next;
      end;
    end;
    tblEvents.Filtered := False;
  end;

  if lstTCalendarItems.Items.Count = 0 then
    lstTCalendarItems.Items.Add('No tasks or events for this date.');
end;

 procedure TfrmTHome.CalendarDateChanged(Sender: TObject);
begin
  LoadCalendarItems(Calendar.Date);
end;
