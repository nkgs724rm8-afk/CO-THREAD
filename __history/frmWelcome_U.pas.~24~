unit frmWelcome_U;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.ExtCtrls,dmsCoolHub_U,
  Vcl.Imaging.pngimage, System.ImageList, Vcl.ImgList, Vcl.ComCtrls,
  Vcl.WinXCalendars, Data.DB, Vcl.Grids, Vcl.DBGrids;

type
  TfrmWelcome = class(TForm)
    imgBackground: TImage;
    imgLoginbtn: TImage;
    imgSignupbtn: TImage;
    imgInfobtn: TImage;
    pnlInfo: TPanel;
    procedure imgLoginbtnClick(Sender: TObject);
    procedure imgSignupbtnClick(Sender: TObject);
    procedure imgInfobtnClick(Sender: TObject);
    procedure FormCreate(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
    var
bInfo : Boolean;
  end;

var
  frmWelcome: TfrmWelcome;

implementation
uses
frmLogin_U,
frmSignUp;

{$R *.dfm}


procedure TfrmWelcome.FormCreate(Sender: TObject);
begin
bInfo := false;
pnlInfo.Hide;
end;

procedure TfrmWelcome.imgInfobtnClick(Sender: TObject);

begin

if bInfo = false then
begin
 bInfo := true;
  pnlInfo.Show;;
end
else
if bInfo = true then
begin
bInfo := false;
  pnlInfo.hide;;
end;
end;

procedure TfrmWelcome.imgLoginbtnClick(Sender: TObject);
begin
frmWelcome.Hide;
frmLogin.Show;
end;

procedure TfrmWelcome.imgSignupbtnClick(Sender: TObject);
begin
frmSign.Show;
frmWelcome.Hide;
end;

end.
