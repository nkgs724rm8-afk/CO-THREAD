unit frmWelcome_U;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.ExtCtrls,dmsCoolHub_U,
  Vcl.Imaging.pngimage, System.ImageList, Vcl.ImgList, Vcl.ComCtrls,
  Vcl.WinXCalendars, Data.DB, Vcl.Grids, Vcl.DBGrids;

type
  TfrmWelcome = class(TForm)
    imgBackground: TImage;
    imgLoginbtn: TImage;
    imgSignupbtn: TImage;
    lblQuotes: TLabel;
    procedure imgLoginbtnClick(Sender: TObject);
    procedure imgSignupbtnClick(Sender: TObject);
    procedure FormCreate(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  frmWelcome: TfrmWelcome;

implementation
uses
frmLogin_U,
frmSignUp;

{$R *.dfm}

//Display random quote from text file
procedure TfrmWelcome.FormCreate(Sender: TObject);
var
tf: TextFile;
iRandom,i: Integer;
sLine : String;
begin

Randomize;
iRandom := Random(30) +1;
assignFile(tf,'Quotes.txt');
try
  reset(tf);
except
  ShowMessage('File Not Found');
  exit;
end;
  i := 0;
 while not eof(tf) do
 begin
 inc(i);
 readln(tf,sLine);
 if i = iRandom then
 begin
   lblQuotes.Caption := sLine;
   break;
 end;
 end;


end;

procedure TfrmWelcome.imgLoginbtnClick(Sender: TObject);
begin
frmWelcome.Hide;
frmLogin.Show;
end;

procedure TfrmWelcome.imgSignupbtnClick(Sender: TObject);
begin
frmSign.Show;
frmWelcome.Hide;
end;

end.
